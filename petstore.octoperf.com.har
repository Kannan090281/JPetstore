            "text": "\n\n\n\n\n\n\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\"\n\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n\n<head>\n<link rel=\"StyleSheet\" href=\"../css/jpetstore.css\" type=\"text/css\"\n\tmedia=\"screen\" />\n\n<meta name=\"generator\"\n\tcontent=\"HTML Tidy for Linux/x86 (vers 1st November 2002), see www.w3.org\" />\n<title>JPetStore Demo</title>\n<meta content=\"text/html; charset=windows-1252\"\n\thttp-equiv=\"Content-Type\" />\n<meta http-equiv=\"Cache-Control\" content=\"max-age=0\" />\n<meta http-equiv=\"Cache-Control\" content=\"no-cache\" />\n<meta http-equiv=\"expires\" content=\"0\" />\n<meta http-equiv=\"Expires\" content=\"Tue, 01 Jan 1980 1:00:00 GMT\" />\n<meta http-equiv=\"Pragma\" content=\"no-cache\" />\n</head>\n\n<body>\n\n<div id=\"Header\">\n\n<div id=\"Logo\">\n<div id=\"LogoContent\">\n&nbsp;\n<a href=\"/actions/Catalog.action\"><img src=\"../images/logo-topbar.svg\" /></a></div>\n</div>\n\n<div id=\"Menu\">\n<div id=\"MenuContent\"><a href=\"/actions/Cart.action?viewCart=\"><img align=\"middle\" name=\"img_cart\" src=\"../images/cart.gif\" /></a> <img align=\"middle\" src=\"../images/separator.gif\" /> \n\t<a href=\"/actions/Account.action?signonForm=\">Sign In</a>\n   <img align=\"middle\" src=\"../images/separator.gif\" /> <a\n\thref=\"../help.html\">?</a></div>\n</div>\n\n<div id=\"Search\">\n<div id=\"SearchContent\"><form method=\"post\" action=\"/actions/Catalog.action\">\n\t<input size=\"14\" name=\"keyword\" type=\"text\" />\n\t<input name=\"searchProducts\" type=\"submit\" value=\"Search\" />\n<div style=\"display: none;\"><input type=\"hidden\" name=\"_sourcePage\" value=\"0PjMSABXHHJtO6jq747vFLYlpEdULYcPA8Xcit0WtvONRyd7567dfB8t2Q-cDNecX7histGPyM6cqCJZ2VHoKNQutnkEJfA2\" /><input type=\"hidden\" name=\"__fp\" value=\"QeK9NCsWlJyejOnepEnXMaF0wMA_QzMn-5LBhmSgkxnBwNvg9zr8BYFHCDEGCCN1\" /></div></form></div>\n</div>\n\n<div id=\"QuickLinks\"><a href=\"/actions/Catalog.action?viewCategory=&amp;categoryId=FISH\"><img src=\"../images/sm_fish.gif\" /></a> <img src=\"../images/separator.gif\" /> <a href=\"/actions/Catalog.action?viewCategory=&amp;categoryId=DOGS\"><img src=\"../images/sm_dogs.gif\" /></a> <img src=\"../images/separator.gif\" /> <a href=\"/actions/Catalog.action?viewCategory=&amp;categoryId=REPTILES\"><img src=\"../images/sm_reptiles.gif\" /></a> <img src=\"../images/separator.gif\" /> <a href=\"/actions/Catalog.action?viewCategory=&amp;categoryId=CATS\"><img src=\"../images/sm_cats.gif\" /></a> <img src=\"../images/separator.gif\" /> <a href=\"/actions/Catalog.action?viewCategory=&amp;categoryId=BIRDS\"><img src=\"../images/sm_birds.gif\" /></a></div>\n\n</div>\n\n<div id=\"Content\">\n\n\n<div id=\"BackLink\"><a href=\"/actions/Catalog.action\">Return to Main Menu</a></div>\n\n<div id=\"Catalog\">\n\n<div id=\"Cart\">\n\n<h2>Shopping Cart</h2>\n<form method=\"post\" action=\"/actions/Cart.action\">\n\t<table>\n\t\t<tr>\n\t\t\t<th><b>Item ID</b></th>\n\t\t\t<th><b>Product ID</b></th>\n\t\t\t<th><b>Description</b></th>\n\t\t\t<th><b>In Stock?</b></th>\n\t\t\t<th><b>Quantity</b></th>\n\t\t\t<th><b>List Price</b></th>\n\t\t\t<th><b>Total Cost</b></th>\n\t\t\t<th>&nbsp;</th>\n\t\t</tr>\n\n\t\t\n\n\t\t\n\t\t\t<tr>\n\t\t\t\t<td><a href=\"/actions/Catalog.action?viewItem=&amp;itemId=EST-1\">EST-1</a></td>\n\t\t\t\t<td>FI-SW-01</td>\n\t\t\t\t<td>Large \n\t\t\t\t \n\t\t\t\t Angelfish</td>\n\t\t\t\t<td>false</td>\n\t\t\t\t<td><input size=\"3\" name=\"EST-1\" type=\"text\" value=\"1\" /></td>\n\t\t\t\t<td>$16.50</td>\n\t\t\t\t<td>$16.50</td>\n\t\t\t\t<td><a href=\"/actions/Cart.action?removeItemFromCart=&amp;workingItemId=EST-1\" class=\"Button\">Remove</a></td>\n\t\t\t</tr>\n\t\t\n\t\t<tr>\n\t\t\t<td colspan=\"7\">Sub Total: $16.50 <input name=\"updateCartQuantities\" type=\"submit\" value=\"Update Cart\" /></td>\n\t\t\t<td>&nbsp;</td>\n\t\t</tr>\n\t</table>\n\n<div style=\"display: none;\"><input type=\"hidden\" name=\"_sourcePage\" value=\"gatFO6Vf6EI5dTrws-z7ys_1SGzx6aHSCUdEjA4DkotOR3cpWAJotMal7xIj92hvSO70QEtp5RVN9G_EJiSSlMxNjrExrOzd\" /><input type=\"hidden\" name=\"__fp\" value=\"cIHxm2Y03vYoU6nXtV78UM71z9Yot8HnYwF2-DZMIauAWhVaNlSxqOX6Z2QqlNrM\" /></div></form> \n\t<a href=\"/actions/Order.action?newOrderForm=\" class=\"Button\">Proceed to Checkout</a>\n</div>\n\n<div id=\"MyList\">\n  \n</div>\n\n<div id=\"Separator\">&nbsp;</div>\n</div>\n\n\n</div>\n\n<div id=\"CTA\">\nElevate you load-testing with <a href=\"https://octoperf.com\">OctoPerf</a>!\n</div>\n\n<div id=\"Footer\">\n\n<div id=\"PoweredBy\">\n&nbsp;&nbsp;Hosted by <a href=\"https://octoperf.com\" target=\"_blank\">https://octoperf.com</a>&nbsp;|&nbsp;Powered by <a href=\"https://mybatis.org/\" target=\"_blank\">www.mybatis.org</a>\n</div>\n\n<div id=\"Banner\"></div>\n\n</div>\n\n</body>\n</html>\n\n"
